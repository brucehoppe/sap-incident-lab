# Copy relevant values into the Desktop config's "env" block (see DESIGN.md
# section 10), or into .env.local for local `uv run sap-incident-lab probe`
# testing. Never commit real incident paths or real system facts here.

INCIDENT_LAB_ROOT=/Users/YOUR_USER/SAPIncidentLabData/incidents
INCIDENT_LAB_OUTPUT=/Users/YOUR_USER/SAPIncidentLabData/outputs
# Choose the Ollama tag for this machine, e.g. qwen3.5:9b (24 GB Mac) or
# qwen3.8 (32 GB Windows).
INCIDENT_LAB_MODEL=qwen3.5:9b
# Optional: used only when the primary model is missing from Ollama.
INCIDENT_LAB_FALLBACK_MODEL=qwen3:8b
INCIDENT_LAB_OLLAMA_URL=http://127.0.0.1:11434
INCIDENT_LAB_NUM_CTX=8192
INCIDENT_LAB_NUM_PREDICT=1200
INCIDENT_LAB_LOG_LEVEL=INFO
